<?xml version="1.0" encoding="UTF-8"?>
<!-- One per engine, since a driver definition fixes DataGrip's dialect. RegisterDriverJar adds the jar. -->
<drivers>
  <driver id="querydesk-postgres" name="QueryDesk (PostgreSQL)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="PostgreSQL">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-mysql" name="QueryDesk (MySQL)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="MySQL">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-sqlserver" name="QueryDesk (SQL Server)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="TSQL">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-oracle" name="QueryDesk (Oracle)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="Oracle">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-clickhouse" name="QueryDesk (ClickHouse)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="ClickHouse">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <!-- the console speaks mongosh, which QueryDesk reads; the catalog comes from QueryDesk's stored schema -->
  <driver id="querydesk-mongodb" name="QueryDesk (MongoDB)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="MongoJS">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <!-- engines with no DataGrip dialect of their own take their wire protocol's -->
  <driver id="querydesk-cockroachdb" name="QueryDesk (CockroachDB)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="Cockroach">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-timescaledb" name="QueryDesk (TimescaleDB)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="PostgreSQL">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-alloydb" name="QueryDesk (Google AlloyDB)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="PostgreSQL">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-redshift" name="QueryDesk (Amazon Redshift)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="Redshift">
    <url-template name="default" template="jdbc:querydesk://{host::app.querydesk.com}[:{port}]/{database}[\?&lt;&amp;,{:identifier}={:param}&gt;]"/>
  </driver>
  <driver id="querydesk-mariadb" name="QueryDesk (MariaDB)" driver-class="com.querydesk.jdbc.QueryDeskDriver" dialect="MariaDB">
